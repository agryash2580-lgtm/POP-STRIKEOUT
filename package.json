{
  "name": "strikeout-final",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "vite build",
    "start": "node server.mjs",
    "demo": "node scripts/serve-demo.mjs",
    "package:demo": "node scripts/package-demo.mjs",
    "qr:demo": "node scripts/devfest-qr.mjs",
    "test:demo": "node --test tests/devfest-demo.test.mjs",
    "typecheck": "tsc --noEmit",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:providers": "node scripts/check-provider-readiness.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "check": "npm run check:syntax && npm run typecheck && npm test && npm run build",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/final-desktop.mjs",
    "package:pop": "node scripts/package-pop.mjs",
    "test:pop": "node --test tests/pop*.test.mjs",
    "test:pop:browser": "node tests/pop-browser.mjs",
    "test:reporting": "node --test tests/reporting*.test.mjs",
    "test:reporting:browser": "node tests/final-desktop.mjs",
    "test:reports": "node --test tests/reports.test.mjs",
    "check:reports:live": "node scripts/check-reports-live.mjs"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "google-auth-library": "^11.3.2",
    "jsqr": "^1.4.0",
    "libphonenumber-js": "^1.12.0",
    "nodemailer": "^10.3.1",
    "otpauth": "^9.5.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.3.8"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "zod": "4.6.6"
  }
}
