# Copy to .env.local. Obtain real values privately from the project owner.
PORT=3002
# Optional Google sign-in. Add the callback URL to your Google OAuth web client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3002/api/auth/google/callback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional overrides for the two separate Gemini calls.
GEMINI_RESEARCH_MODEL=gemini-3.5-flash-lite
GEMINI_REPORT_MODEL=gemini-3.5-flash-lite
# Email requires a verified sender/domain in Resend. Never put these in VITE_*.
RESEND_API_KEY=
REPORT_EMAIL_FROM=
BLOB_READ_WRITE_TOKEN=
# Local development defaults to private files in .data.
# STORAGE_BACKEND=blob

# Optional OSINT providers; no keys are needed for GitHub/documents/password prefixes.
BRAVE_SEARCH_API_KEY=
HIBP_API_KEY=
# Existing STRIKEOUT usernames allowed to sign into the local Instagram service browser.
INSTAGRAM_OPERATOR_USERNAMES=
# Set false to show its native browser window; default true uses the operator preview.
INSTAGRAM_HEADLESS=true
ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# Optional automatic Google and Google Lens results. Free Google handoff needs no key.
SERPAPI_API_KEY=

# Gmail alternative: use a dedicated account and an app password, not its login password.
SMTP_USER=
SMTP_APP_PASSWORD=

# Default is contextual shared Pop chat. Set true only for optional fixed reviewed replies.
POP_REVIEWED_REPLIES_ONLY=false

# Required for authenticator MFA. Generate 32 random bytes, base64 encoded. Keep stable and private.
MFA_ENCRYPTION_KEY=

# Separate Google keys for the two Get help assistants (server only).
CYBER_GEMINI_API_KEY=
THERAPY_GEMINI_API_KEY=
SPECIALIST_GEMINI_MODEL=gemini-2.5-flash

# Required SMS verification for exposure checks. Server-only Twilio Verify credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Stable random secret of at least 32 characters; used to HMAC phone numbers.
OSINT_PHONE_HASH_KEY=
