# Copy to the repository root as .env.production, then set a new private key.
# Keep this file and the mounted data volume across restarts and upgrades.
MFA_ENCRYPTION_KEY=

# Optional provider integrations. Leave blank to show honest unavailable states.
SERPAPI_API_KEY=
BRAVE_SEARCH_API_KEY=
HIBP_API_KEY=
GEMINI_API_KEY=
RESEND_API_KEY=
REPORT_EMAIL_FROM=
# Alternative existing mail adapter: provide both values privately, or leave both blank.
# This is a Gmail app password for the sender; never use an account sign-in password.
SMTP_USER=
SMTP_APP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
