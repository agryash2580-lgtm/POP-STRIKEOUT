{
  "manifest_version": 3,
  "name": "Pop by STRIKEOUT",
  "version": "2.1.3",
  "description": "A pet with a job: find watched information, catch accidental sharing and save reviewed evidence.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "downloads"
  ],
  "host_permissions": [
    "https://strikeout-wheat.vercel.app/*",
    "http://localhost:3002/*",
    "http://127.0.0.1:3002/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_popup": "panel.html",
    "default_title": "Pop's tools"
  },
  "background": {
    "scripts": ["shared.js", "background.js"]
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "icons": {
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["pop.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pop@strikeout.app",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["personalCommunications", "websiteContent"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://strikeout-wheat.vercel.app/*",
        "http://localhost:3002/*",
        "http://127.0.0.1:3002/*"
      ],
      "js": ["website-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
