{
  "manifest_version": 3,
  "name": "Pop by STRIKEOUT",
  "version": "2.3.0",
  "description": "A pet with a job: find watched information, catch accidental sharing and save reviewed evidence.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "downloads",
    "declarativeNetRequest",
    "webNavigation"
  ],
  "host_permissions": [
    "https://strikeout-mu20.vercel.app/*",
    "http://localhost:3002/*",
    "http://127.0.0.1:3002/*",
    "https://strikeout-wheat.vercel.app/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "panel.html",
    "default_title": "Pop's tools"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "icons": {
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pop.png",
        "link-warning.html",
        "link-warning.js",
        "panel.css"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://strikeout-mu20.vercel.app/*",
        "http://localhost:3002/*",
        "http://127.0.0.1:3002/*",
        "https://strikeout-wheat.vercel.app/*"
      ],
      "js": [
        "website-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
